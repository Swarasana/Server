    "@types/node": "^24.10.1",
    "@types/node-fetch": "^2.6.13",
    "@types/qrcode": "^1.5.6",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
